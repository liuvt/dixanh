    private async Task ReloadAllAsync()
    {
        var v = await VehicleService.GetAsync(_model.VehicleId);
        if (v != null) _model = v;

        _currentStatusName = _model.Status?.Name
            ?? _statuses.FirstOrDefault(x => x.StatusId == _model.StatusId)?.Name
            ?? "";

        _manufactureDateLocal = _model.ManufactureDate?.UtcDateTime.Date;

        _statusHistory = await VehicleStatusHistoryService.GetByVehicleAsync(_model.VehicleId, 200);
        _codeHistory = await VehicleCodeHistoryService.GetByVehicleAsync(_model.VehicleId, 200);

        _editVm = VehicleEditVm.FromModel(_model);
        _editEditContext = new EditContext(_editVm);
    }

    #region Vehicle Code Change Methods

    private string? _codeEffectiveAtRaw;

    private void OnEffectiveAtChanged(ChangeEventArgs e)
    {
        _codeEffectiveAtRaw = e.Value?.ToString();
    }

    // datetime-local chuẩn: "yyyy-MM-ddTHH:mm"
    private static DateTime? ParseDatetimeLocal(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;

        if (DateTime.TryParseExact(
            raw.Trim(),
            "yyyy-MM-ddTHH:mm",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var dt))
            return dt;

        return null;
    }

    private async Task ChangeVehicleCodeAsync()
    {
        if (IsReadOnly) return;
        if (string.IsNullOrWhiteSpace(_model.VehicleId)) return;

        _error = null;
        _success = null;
        _saving = true;

        try
        {
            // Validate ngay trên UI
            var dtLocal = ParseDatetimeLocal(_codeEffectiveAtRaw);
            if (!dtLocal.HasValue)
                throw new InvalidOperationException("Vui lòng chọn 'Hiệu lực từ'.");

            if (string.IsNullOrWhiteSpace(_codeOperatingArea))
                throw new InvalidOperationException("Vui lòng chọn Khu vực.");

            if (string.IsNullOrWhiteSpace(_codeVehicleCode))
                throw new InvalidOperationException("Vui lòng nhập Số hiệu xe mới.");

            // Convert VN local -> UTC (hàm ToUtcFromVnLocal bạn đã có)
            var validFromUtc = ToUtcFromVnLocal(dtLocal.Value);

            var dto = new VehicleCodeChangeDto
            {
                VehicleId = _model.VehicleId,
                OperatingArea = _codeOperatingArea.Trim(),
                VehicleCode = _codeVehicleCode.Trim(),
                ValidFrom = validFromUtc,
                ChangeReason = _codeReason
            };

            Console.WriteLine($"UI raw={_codeEffectiveAtRaw} | local={dtLocal:O} | utc={validFromUtc:O}");
            Console.WriteLine($"DTO.ValidFrom={dto.ValidFrom:O}");

            await VehicleService.ChangeVehicleCodeAsync(dto, CurrentUserName);

            // Reset form
            _codeVehicleCode = "";
            _codeReason = "";
            _codeOperatingArea = "";
            _codeEffectiveAtRaw = null;

            await ReloadAllAsync();
            _success = "Đổi số hiệu thành công.";
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.GetBaseException().Message;
        }
        finally
        {
            _saving = false;
        }
    }
    #endregion

