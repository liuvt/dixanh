@using System.ComponentModel.DataAnnotations
@using dixanh.Libraries.Models
@using dixanh.Services.Interfaces
@using dixanh.Components.Layout

@inject IVehicleService VehicleService
@inject IVehicleStatusService VehicleStatusService
@inject IVehicleStatusHistoryService VehicleStatusHistoryService
@inject IVehicleCodeHistoryService VehicleCodeHistoryService

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (Open)
{
    <div class="fixed inset-0 z-40">
        <!-- overlay -->
        <div class="absolute inset-0 bg-black/30" @onclick="Close"></div>

        <!-- panel -->
        <div class="absolute top-0 right-0 h-full w-full max-w-2xl bg-white shadow-xl">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-200 p-4">
                <div>
                    <div class="text-sm text-slate-500">Vehicle</div>
                    <div class="text-lg font-semibold text-slate-900">@Title</div>
                </div>
                <button type="button" class="@_TVTTemplate.UiBtnOutline" @onclick="Close">Thoát</button>
            </div>

            <!-- Tabs (Option A: XÓA tab history) -->
            <div class="border-b border-slate-200 px-4">
                <div class="flex gap-3 text-sm">
                    <button type="button" class="@TabClass("info")" @onclick="@(() => SelectTab("info"))">Thông tin</button>

                    <button type="button"
                            class="@TabClass("code")"
                            disabled="@DisableNonInfoTabs"
                            @onclick="@(() => SelectTab("code"))">
                        Số hiệu xe
                    </button>

                    <button type="button"
                            class="@TabClass("status")"
                            disabled="@DisableNonInfoTabs"
                            @onclick="@(() => SelectTab("status"))">
                        Trạng thái
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="h-[calc(100%-112px)] overflow-auto p-4">
                @if (_loading)
                {
                    <div class="text-slate-600">Loading...</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="@_TVTTemplate.UiMsError">
                            @_error
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_success))
                    {
                        <div class="@_TVTTemplate.UiMsSuccess">
                            @_success
                        </div>
                    }

                    @* ===================== TAB INFO ===================== *@
                    @if (_tab == "info")
                    {
                        @if (_modeIsCreate)
                        {
                            <!-- CREATE: bind VehicleCreateDto để chạy validation chuẩn -->
                            <EditForm EditContext="_createEditContext"
                                      OnValidSubmit="SaveCreateAsync"
                                      OnInvalidSubmit="InvalidSubmit">
                                <DataAnnotationsValidator />
                                <!-- <ValidationSummary class="@_TVTTemplate.UiMsError" />-->

                                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                    <div class="md:col-span-2">
                                        <label class="text-sm font-medium text-slate-700">VehicleId</label>
                                        <input class="@_TVTTemplate.UiInput" value="@(_model.VehicleId ?? "")" disabled />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số hiệu xe (Số tài)</label>
                                        <InputText class="@_TVTTemplate.UiInput"
                                                   placeholder="RG1234"
                                                   @bind-Value="_create.CurrentVehicleCode" />
                                        <ValidationMessage For="@(() => _create.CurrentVehicleCode)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Khu vực</label>
                                        <InputSelect class="@_TVTTemplate.UiSelect" @bind-Value="_create.OperatingArea">
                                            <option value="">-- Chọn khu vực --</option>
                                            @foreach (var a in _operatingAreas)
                                            {
                                                <option value="@a">@a</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => _create.OperatingArea)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Biển số</label>
                                        <InputText class="@_TVTTemplate.UiInput"
                                                   placeholder="68G-000.01"
                                                   @bind-Value="_create.LicensePlate" />
                                        <ValidationMessage For="@(() => _create.LicensePlate)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Thương hiệu</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_create.Brand" />
                                        <ValidationMessage For="@(() => _create.Brand)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số chỗ</label>
                                        <InputNumber class="@_TVTTemplate.UiSelect" @bind-Value="_create.SeatCount" />
                                        <ValidationMessage For="@(() => _create.SeatCount)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Màu</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_create.Color" />
                                        <ValidationMessage For="@(() => _create.Color)" class="@_TVTTemplate.UiMsError" />

                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Ngày sản xuất</label>
                                        <InputDate class="@_TVTTemplate.UiInput" @bind-Value="_manufactureDateLocal" />
                                        <ValidationMessage For="@(() => _create.ManufactureDate)" class="@_TVTTemplate.UiMsError" />

                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Loại xe</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_create.VehicleType" />
                                        <ValidationMessage For="@(() => _create.VehicleType)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số khung</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_create.ChassisNumber" />
                                        <ValidationMessage For="@(() => _create.ChassisNumber)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số máy</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_create.EngineNumber" />
                                        <ValidationMessage For="@(() => _create.EngineNumber)" class="@_TVTTemplate.UiMsError" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="text-sm font-medium text-slate-700">Trạng thái</label>
                                        <InputSelect class="@_TVTTemplate.UiSelect" @bind-Value="_create.StatusId">
                                            @foreach (var s in _statuses)
                                            {
                                                <option value="@s.StatusId">@s.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => _create.StatusId)" class="@_TVTTemplate.UiMsError" />
                                    </div>
                                </div>

                                <div class="mt-5 flex justify-end gap-2">
                                    <button type="submit" class="@_TVTTemplate.UiBtnPrimary" disabled="@_saving">
                                        Lưu lại
                                    </button>
                                </div>
                            </EditForm>
                        }
                        else
                        {
                            <!-- VIEW/EDIT: cùng 1 form, View thì KHÔNG hiển thị nút Lưu -->
                            <EditForm EditContext="_editEditContext"
                                      OnValidSubmit="SaveEditAsync"
                                      OnInvalidSubmit="InvalidSubmit">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                    <div class="md:col-span-2">
                                        <label class="text-sm font-medium text-slate-700">VehicleId</label>
                                        <input class="@_TVTTemplate.UiInput" value="@(_model.VehicleId ?? "")" disabled />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Biển số</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_editVm.LicensePlate" disabled="@IsReadOnly" />
                                        <ValidationMessage For="@(() => _editVm.LicensePlate)" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Thương hiệu</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_editVm.Brand" disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số chỗ</label>
                                        <InputNumber class="@_TVTTemplate.UiSelect" @bind-Value="_editVm.SeatCount" disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Màu</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_editVm.Color" disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Ngày sản xuất</label>
                                        <InputDate class="@_TVTTemplate.UiInput" @bind-Value="_manufactureDateLocal" disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Loại xe</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_editVm.VehicleType" disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số khung</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_editVm.ChassisNumber" disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số máy</label>
                                        <InputText class="@_TVTTemplate.UiInput" @bind-Value="_editVm.EngineNumber" disabled="@IsReadOnly" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="text-sm font-medium text-slate-700">Trạng thái</label>
                                        <InputSelect class="@_TVTTemplate.UiSelect" @bind-Value="_editVm.StatusId" disabled="@IsReadOnly">
                                            @foreach (var s in _statuses)
                                            {
                                                <option value="@s.StatusId">@s.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => _editVm.StatusId)" />
                                    </div>
                                </div>

                                @* View thì không hiện button (giống yêu cầu của bạn) *@
                                @if (!IsReadOnly)
                                {
                                    <div class="mt-5 flex justify-end gap-2">
                                        <button type="submit" class="@_TVTTemplate.UiBtnPrimary" disabled="@_saving">
                                            Lưu lại
                                        </button>
                                    </div>
                                }
                            </EditForm>
                        }
                    }

                    @* ===================== TAB CODE ===================== *@
                    @if (_tab == "code")
                    {
                        <div class="rounded-xl border border-slate-200 p-4">
                            <div class="text-sm text-slate-500">Số hiệu hiện tại</div>
                            <div class="mt-1 text-lg font-semibold text-slate-900">@(_model.CurrentVehicleCode ?? "")</div>
                            @* View thì không hiện button đổi số hiệu *@
                            @if (!IsReadOnly)
                            {
                                <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Khu vực</label>
                                        <select class="@_TVTTemplate.UiSelect" @bind="_codeOperatingArea" disabled="@IsReadOnly">
                                            <option value="">-- Chọn khu vực --</option>
                                            @foreach (var a in _operatingAreas)
                                            {
                                                <option value="@a">@a</option>
                                            }
                                        </select>
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Số hiệu xe mới</label>
                                        <input class="@_TVTTemplate.UiInput"
                                               placeholder="VD: 0123"
                                               @bind="_codeVehicleCode"
                                               @bind:event="oninput"
                                               disabled="@IsReadOnly" />
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Hiệu lực từ</label>

                                        <input type="datetime-local"
                                               class="@_TVTTemplate.UiInput"
                                               value="@_codeEffectiveAtRaw"
                                               @onchange="OnEffectiveAtChanged"
                                               step="60"
                                               disabled="@IsReadOnly" />

                                        @* debug (tạm thời) *@
                                        <div class="mt-1 text-xs text-slate-500">
                                            raw: @_codeEffectiveAtRaw
                                        </div>
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="text-sm font-medium text-slate-700">Lý do</label>
                                        <input class="@_TVTTemplate.UiInput"
                                               placeholder="VD: chuyển đội / đổi khu vực..."
                                               @bind="_codeReason"
                                               @bind:event="oninput"
                                               disabled="@IsReadOnly" />
                                    </div>
                                </div>

                                <div class="mt-4 flex justify-end gap-2">
                                    <button type="button"
                                            class="@_TVTTemplate.UiBtnPrimary"
                                            @onclick="ChangeVehicleCodeAsync"
                                            disabled="@(_saving)">
                                        Đổi số hiệu
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
                            <div class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700">
                                Lịch sử số hiệu (mới nhất trước)
                            </div>

                            <div class="overflow-auto">
                                <table class="w-full text-sm">
                                    <thead class="bg-white">
                                        <tr class="text-left text-slate-600">
                                            <th class="px-4 py-3 font-medium">Ngày hiệu lực</th>
                                            <th class="px-4 py-3 font-medium">Khu vực</th>
                                            <th class="px-4 py-3 font-medium">Số hiệu</th>
                                            <th class="px-4 py-3 font-medium">Thời gian chuyển</th>
                                            <th class="px-4 py-3 font-medium">Chuyển bởi</th>
                                            <th class="px-4 py-3 font-medium">Chuyển với lý do</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200">
                                        @if (_codeHistory.Count == 0)
                                        {
                                            <tr><td class="px-4 py-4 text-slate-600" colspan="6">No code history</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var h in _codeHistory)
                                            {
                                                <tr class="hover:bg-slate-50">
                                                    <td class="px-4 py-3">@FormatLocal(h.ValidFrom)</td>
                                                    <td class="px-4 py-3">@h.OperatingArea</td>
                                                    <td class="px-4 py-3">@h.VehicleCode</td>
                                                    <td class="px-4 py-3">@FormatLocal(h.ChangedAt)</td>
                                                    <td class="px-4 py-3">@h.ChangedBy</td>
                                                    <td class="px-4 py-3">@h.ChangeReason</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @* ===================== TAB STATUS (form + history ngay bên dưới) ===================== *@
                    @if (_tab == "status")
                    {
                        <!-- Status form -->
                        <div class="rounded-xl border border-slate-200 p-4">
                            <div class="text-sm text-slate-500">Trạng thái hiện tại</div>
                            <div class="mt-1 text-lg font-semibold text-slate-900">@_TVTTemplate.StatusBadge(_currentStatusCode, _currentStatusName)</div>
                            @* View thì không hiển thị nút thay đổi *@
                            @if (!IsReadOnly)
                            {
                                <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Chuyển sang</label>
                                        <select class="@_TVTTemplate.UiSelect" @bind="_toStatusId" disabled="@IsReadOnly">
                                            @foreach (var s in _statuses)
                                            {
                                                <option value="@s.StatusId">@s.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div>
                                        <label class="text-sm font-medium text-slate-700">Ghi chú</label>
                                        <input class="@_TVTTemplate.UiInput"
                                               placeholder="Lý do đổi trạng thái..."
                                               @bind="_statusNote"
                                               disabled="@IsReadOnly" />
                                    </div>
                                </div>

                                <div class="mt-4 flex flex-wrap justify-end gap-2">
                                    <button type="button"
                                            class="@_TVTTemplate.UiBtnOutline"
                                            @onclick="SoftDeleteAsync"
                                            disabled="@_saving">
                                        Ngừng hoạt động
                                    </button>

                                    <button type="button"
                                            class="@_TVTTemplate.UiBtnOutline"
                                            @onclick="RestoreAsync"
                                            disabled="@_saving">
                                        Khôi phục
                                    </button>

                                    <button type="button"
                                            class="@_TVTTemplate.UiBtnPrimary"
                                            @onclick="ChangeStatusAsync"
                                            disabled="@_saving">
                                        Áp dụng
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Status history right below -->
                        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
                            <div class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700">
                                Lịch sử trạng thái (mới nhất trước)
                            </div>

                            <div class="overflow-auto">
                                <table class="w-full text-sm">
                                    <thead class="bg-white">
                                        <tr class="text-left text-slate-600">
                                            <th class="px-4 py-3 font-medium">Chuyển lúc</th>
                                            <th class="px-4 py-3 font-medium">Chuyển từ</th>
                                            <th class="px-4 py-3 font-medium">Chuyển thành</th>
                                            <th class="px-4 py-3 font-medium">Chuyển bởi</th>
                                            <th class="px-4 py-3 font-medium">Chuyển với nội dung</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200">
                                        @if (_statusHistory.Count == 0)
                                        {
                                            <tr><td class="px-4 py-4 text-slate-600" colspan="5">No status history</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var h in _statusHistory)
                                            {
                                                <tr class="hover:bg-slate-50">
                                                    <td class="px-4 py-3">@FormatLocal(h.ChangedAt)</td>
                                                    <td class="px-4 py-3">@h.FromStatus?.Name</td>
                                                    <td class="px-4 py-3">@h.ToStatus?.Name</td>
                                                    <td class="px-4 py-3">@h.ChangedBy</td>
                                                    <td class="px-4 py-3">@h.Note</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Mode { get; set; } = "view"; // create|view|edit
    [Parameter] public string? VehicleId { get; set; }
    [Parameter] public string CurrentUserName { get; set; } = "system";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _loading;
    private bool _saving;
    private string? _error;
    private string? _success;

    private string _tab = "info";
    private string _effectiveMode = "view";
    private bool _modeIsCreate => _effectiveMode == "create";
    private bool IsReadOnly => _effectiveMode == "view"; // VIEW: không cho thao tác

    private Vehicle _model = new();

    // CREATE: bind VehicleCreateDto (validation chuẩn)
    private VehicleCreateDto _create = new();
    private EditContext _createEditContext = default!;

    // EDIT/VIEW: VM riêng
    private VehicleEditVm _editVm = new();
    private EditContext _editEditContext = default!;

    // date input (date-only)
    private DateTime? _manufactureDateLocal;

    // statuses
    private List<VehicleStatus> _statuses = new();
    private int _toStatusId;
    private string? _statusNote;
    private string _currentStatusName = "";
    private string _currentStatusCode = "";

    // histories
    private List<VehicleStatusHistory> _statusHistory = new();
    private List<VehicleCodeHistoryItemDto> _codeHistory = new();

    // change code fields
    private string? _codeOperatingArea;
    private string? _codeVehicleCode;
    private string? _codeReason;

    #region Change Status Methods

    #endregion

    private readonly List<string> _operatingAreas = new()
    { "Rạch Giá", "Phú Quốc", "Cần Thơ", "Sóc Trăng", "Hậu Giang", "Cà Mau", "An Giang", "Bạc Liêu", "Vĩnh Long" };

    private string Title => _effectiveMode switch
    {
        "create" => "Tạo mới xe",
        "edit" => "Cập nhật xe",
        _ => "Xem xe"
    };

    private bool DisableNonInfoTabs => _modeIsCreate || string.IsNullOrWhiteSpace(_model.VehicleId);
    private bool CanSubmitChangeCode => !IsReadOnly
                                        && !_saving
                                        && !string.IsNullOrWhiteSpace(_model.VehicleId)
                                        && !string.IsNullOrWhiteSpace(_codeOperatingArea)
                                        && !string.IsNullOrWhiteSpace(_codeVehicleCode)
                                        && ParseDatetimeLocal(_codeEffectiveAtRaw).HasValue; // bắt buộc có ngày

    protected override async Task OnParametersSetAsync()
    {
        if (!Open) return;

        _error = null;
        _success = null;
        _loading = true;

        try
        {
            _effectiveMode = (Mode ?? "view").Trim().ToLowerInvariant();
            if (_effectiveMode is not ("view" or "edit" or "create")) _effectiveMode = "view";

            _statuses = await VehicleStatusService.GetAllAsync(onlyActive: true);
            _tab = "info"; // luôn mở info khi mở drawer

            if (_modeIsCreate)
            {
                _model = new Vehicle { VehicleId = Guid.NewGuid().ToString() };

                _create = new VehicleCreateDto
                {
                    StatusId = _statuses.FirstOrDefault()?.StatusId ?? 1,
                    LicensePlate = "" // tránh null
                };
                _createEditContext = new EditContext(_create);

                _manufactureDateLocal = null;

                _toStatusId = _create.StatusId;
                _currentStatusName = _statuses.FirstOrDefault(x => x.StatusId == _toStatusId)?.Name ?? "";
                _currentStatusCode = _statuses.FirstOrDefault(x => x.StatusId == _toStatusId)?.Code ?? "";

                _statusHistory = new();
                _codeHistory = new();

                _codeOperatingArea = "";
                _codeVehicleCode = "";
                _codeReason = "";
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(VehicleId))
                {
                    var v = await VehicleService.GetAsync(VehicleId);
                    _model = v ?? new Vehicle { VehicleId = VehicleId };

                    _manufactureDateLocal = _model.ManufactureDate?.UtcDateTime.Date;

                    _toStatusId = _model.StatusId;
                    _currentStatusName = _model.Status?.Name
                        ?? _statuses.FirstOrDefault(x => x.StatusId == _model.StatusId)?.Name
                        ?? "";

                    // load histories
                    _statusHistory = await VehicleStatusHistoryService.GetByVehicleAsync(_model.VehicleId, 200);
                    _codeHistory = await VehicleCodeHistoryService.GetByVehicleAsync(_model.VehicleId, 200);

                    // init edit vm
                    _editVm = VehicleEditVm.FromModel(_model);
                    _editEditContext = new EditContext(_editVm);

                    _codeOperatingArea = "";
                    _codeVehicleCode = "";
                    _codeReason = "";
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.GetBaseException().Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectTab(string tab)
    {
        _tab = tab;
        _error = null;
        _success = null;
        StateHasChanged();
    }

    private string TabClass(string tab)
        => "px-3 py-3 border-b-2 " + (tab == _tab
            ? "border-emerald-600 text-emerald-700 font-semibold"
            : "border-transparent text-slate-600 hover:text-slate-900");

    private void InvalidSubmit(EditContext _)
    {
