    private static DateTimeOffset? ToUtcDateOnly(DateTime? d)
    {
        if (!d.HasValue) return null;
        var utc = DateTime.SpecifyKind(d.Value.Date, DateTimeKind.Utc);
        return new DateTimeOffset(utc);
    }

    // format DateTimeOffset? to local string
    private static string FormatLocal(DateTimeOffset? dt)
        => dt.HasValue ? dt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "";

    private static TimeZoneInfo GetVnTz()
    {
        // Linux
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Ho_Chi_Minh"); }
        catch { /* ignore */ }

        // Windows
        return TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
    }

    private static DateTimeOffset ToUtcFromVnLocal(DateTime localNoKind)
    {
        // datetime-local parse ra thường Unspecified => ta coi nó là giờ VN
        var vnTz = GetVnTz();

        var unspecified = DateTime.SpecifyKind(localNoKind, DateTimeKind.Unspecified);
        var offset = vnTz.GetUtcOffset(unspecified);

        // gắn offset +07:00 đúng chuẩn, rồi đưa về UTC
        return new DateTimeOffset(unspecified, offset).ToUniversalTime();
    }

    private async Task SaveCreateAsync()
    {
        if (IsReadOnly) return;

        _error = null;
        _success = null;
        _saving = true;

        try
        {
            // map date -> utc date-only
            _create.ManufactureDate = ToUtcDateOnly(_manufactureDateLocal);

            // normalize string
            _create.OperatingArea = _create.OperatingArea?.Trim();
            _create.CurrentVehicleCode = _create.CurrentVehicleCode?.Trim();
            _create.LicensePlate = (_create.LicensePlate ?? "").Trim();

            var created = await VehicleService.CreateAsync(_create, CurrentUserName);

            _model.VehicleId = created.VehicleId;

            // chuyển sang edit và reload
            _effectiveMode = "edit";
            await ReloadAllAsync();

            _success = "Tạo xe thành công.";
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.GetBaseException().Message;
        }
        finally
        {
            _saving = false;
        }
    }

